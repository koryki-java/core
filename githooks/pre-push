#!/bin/sh
#
# Rejects a push that would carry a secret to GitHub.
#
# Enable it once per clone:
#     git config core.hooksPath githooks
#
# GitHub's push protection does the same on the server, and the secret-scan workflow does it after
# the fact. This one runs before anything leaves the machine, which is the only point where a
# secret still needs no rotating.
#
# With gitleaks installed (brew install gitleaks) the full rule set applies. Without it, the
# fallback below catches only the loudest patterns -- better than nothing, not a substitute.

set -u

zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')
status=0

scan_range() {
    range="$1"
    if command -v gitleaks >/dev/null 2>&1; then
        gitleaks git --redact --no-banner --exit-code 1 --platform=github -v \
            --log-opts="$range" || return 1
        return 0
    fi

    # Fallback: added lines only, high-signal patterns only.
    # $range is deliberately unquoted -- for a new branch it is three words.
    hits=$(mktemp)
    added=$(mktemp)
    # shellcheck disable=SC2086
    git log -p --no-color -U0 $range -- 2>/dev/null | grep -E '^\+' > "$added"

    # A token of a known shape carries its own evidence: always a finding, wherever it stands.
    grep -E -- 'gh[pousr]_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}' \
        "$added" > "$hits" 2>/dev/null

    # A PEM header, or a literal assigned to a password/secret/token name. Both also occur in code
    # that merely mentions them -- a call, a method reference, a property lookup. Measured against
    # the history of this repository, those lines were the only matches, so they are filtered out:
    # a pasted key or password sits on a line of its own.
    grep -Ei -- '-----BEGIN [A-Z ]*PRIVATE KEY-----|(^|[^A-Za-z])(password|passwd|secret|token|api[_-]?key)[[:space:]]*[=:][[:space:]]*[^[:space:]"'"'"'<${}]{8,}' "$added" 2>/dev/null \
        | grep -vE '::|\(|\$\{|getenv|getProperty|findProperty|environmentVariable' \
        >> "$hits" 2>/dev/null
    rm -f "$added"
    if [ -s "$hits" ]; then
        echo "pre-push: possible secret in $range (gitleaks not installed, pattern match):" >&2
        cut -c1-120 "$hits" | head -5 >&2
        rm -f "$hits"
        return 1
    fi
    rm -f "$hits"
    return 0
}

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue                 # branch deletion, nothing to scan
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes"                 # new branch: everything not yet pushed
    else
        range="$remote_sha..$local_sha"
    fi
    scan_range "$range" || status=1
done

if [ "$status" -ne 0 ]; then
    cat >&2 <<'EOF'

pre-push: push rejected -- the commits above look like they contain a secret.

  * false positive: git push --no-verify
  * real secret:    rotate it first, then rewrite the commits that carry it
EOF
fi

exit $status
