@startebnf
' border and background
skinparam legendBorderColor transparent
skinparam legendBackgroundColor white

'title expression

expression =
 expression, selector
| "(", expression, ")"
| "-", expression
| "+", expression
| expression, ("*" | "/"), expression
| expression, ("+" | "-"), expression
| temporal_literal
| field
| function
| "ID"
| "INT"
| "NUMBER"
| "SQ_STRING"
| "NULL"
| "(", select, ")"
;

@endebnf
