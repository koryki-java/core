// Positions from 1, as in KQL; from the end through the length, which PostgreSQL has no negative
// position for. A position outside the array is NULL. A range is inclusive, with open ends.
FIND check_complex t
FETCH t.nr, t.tags@1 first_tag, t.tags@-1 last_tag, t.tags@-2 last_but_one, t.tags@5 fifth_tag,
      t.scores@2 second_score, t.tags@1:2 first_two, t.tags@2: from_second, t.tags@:2 up_to_second,
      t.vec@3 vec_last
